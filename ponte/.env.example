# Copie este arquivo para .env e preencha. O .env nao vai para o GitHub.

# Broker MQTT (o mesmo do sketch.ino)
MQTT_BROKER=broker.hivemq.com
MQTT_PORTA=1883
TOPICO_RAIZ=geladeira-solidaria/rm567693/geladeira

# API Java (projeto geladeira-solidaria-api). Use false para so ver as mensagens.
ENVIAR_API=true
API_URL=http://localhost:8080
# Usuario de teste do papel SENSOR (README da API Java). Em producao, troque.
API_EMAIL=sensor@geladeira.test
API_SENHA=Sensor@123

# Historico usado pelo resumo_ia.py
ARQUIVO_CSV=historico.csv

# Opcional: chave da API da Anthropic para o resumo com IA generativa.
# Sem ela, o resumo_ia.py gera o boletim pelas regras, sem IA.
ANTHROPIC_API_KEY=
